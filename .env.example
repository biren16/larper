# Public application and Supabase browser configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only credentials. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INGESTION_SECRET=generate-a-long-random-secret
YOUTUBE_API_KEY=your-youtube-data-api-key

# Both the database role and this exact email allowlist are required for Studio.
FOUNDER_EMAIL_ALLOWLIST=founder@example.com

# GitHub Actions secrets, not Vercel variables.
SUPABASE_DB_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
BACKUP_ENCRYPTION_KEY=generate-a-separate-long-random-secret
