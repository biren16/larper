# Copy to .env.staging. Node 22 loads this file only for npm run test:staging.
# Use a separate Supabase project and Vercel deployment with staging-only data.
STAGING_APP_URL=https://your-staging-app.vercel.app
STAGING_SUPABASE_URL=https://your-staging-project.supabase.co

# Explicit production exclusions: these must be the actual live origins.
STAGING_PRODUCTION_APP_URL=https://larper-social.vercel.app
STAGING_PRODUCTION_SUPABASE_URL=https://grhknllxfxdjoofiqryz.supabase.co

# Set true only after the staging deployment uses the separate staging project.
STAGING_ALLOW_MUTATIONS=false
STAGING_SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-only-service-role-key
STAGING_INGESTION_SECRET=replace-with-staging-only-ingestion-secret
STAGING_AUTH_STATE=.auth/staging.json
STAGING_INPUT_FILE=.auth/staging-input.json
